# ---- Better Auth ----
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Local: http://localhost:3000  |  Production: your Vercel URL (https://your-app.vercel.app)
BETTER_AUTH_URL=http://localhost:3000

# ---- Database (MongoDB Atlas free tier works on Vercel) ----
MONGODB_URI=
MONGODB_DB=bazardor

# ---- Social login (optional until you set them up) ----
# Google: https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: https://github.com/settings/developers
#   Authorization callback URL: {BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- BazarDor API (optional overrides) ----
# BAZARDOR_API_URL=https://api.api-store.workers.dev/api/bazardor
# BAZARDOR_API_FALLBACK_URL=https://api.abcz.workers.dev/api/bazardor
